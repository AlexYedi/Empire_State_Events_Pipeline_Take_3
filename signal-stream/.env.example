# signal-stream — environment template
# Copy to `.env` (gitignored) and fill in. Never commit real values.
# Scripts hand-parse this file (stdlib, no python-dotenv), mirroring the repo convention.

# ── Confluent Cloud: Global API key (org-scoped) ──────────────────────────────
# Create in Confluent Cloud Console → right-nav account menu → API keys → "Add key"
# → scope = "Global access" (NOT cluster/SR-scoped — resource-scoped keys are the #1 401 cause).
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Your Confluent org id (Console → Settings → Organization; also in the URL). Used in the regional MCP URL.
CONFLUENT_ORG_ID=

# Cluster placement — must match a region where Confluent Cloud Flink is available.
CONFLUENT_CLOUD=aws              # aws | gcp | azure
CONFLUENT_REGION=us-east-1       # e.g. us-east-1, us-west-2

# Cluster + Kafka REST endpoint (Console → your cluster → Cluster settings).
# REST endpoint looks like: https://pkc-xxxxx.us-east-1.aws.confluent.cloud
CONFLUENT_CLUSTER_ID=
CONFLUENT_KAFKA_REST_ENDPOINT=

# Topics
RAW_TOPIC=raw_signals
SIGNALS_TOPIC=gtm_signals

# ── Model provider (for Flink CREATE MODEL / ML_PREDICT) ──────────────────────
# VERIFY which providers Confluent Cloud Flink supports (OpenAI / Azure OpenAI / Bedrock / Vertex AI…)
# and use a key you actually have. This key is referenced by the Flink CREATE CONNECTION, not by the
# Python scripts — keep it here for reference.
MODEL_PROVIDER=openai
MODEL_PROVIDER_API_KEY=

# ── Notion sink ───────────────────────────────────────────────────────────────
# A Notion *internal integration* token (https://www.notion.so/my-integrations → New integration →
# copy the "Internal Integration Secret"), then SHARE the target database with that integration.
# (This is a token, distinct from the pipeline's OAuth MCP connector — the standalone sink needs its own.)
NOTION_TOKEN=
# The data source / database id to write signal rows into (a dedicated "Signal Inbox" DB is cleanest).
NOTION_SIGNAL_DB=
