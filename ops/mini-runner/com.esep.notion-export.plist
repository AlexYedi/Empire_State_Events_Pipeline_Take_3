<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- YED-384 plan B3: daily incremental Notion brief export at 04:30 local (America/New_York), before the 05:00 reconcile.
     Read-only against Notion; writes only gitignored .claude/.state/notion-export-live/ and notion-export.watermark.json. Needs
     NOTION_TOKEN in the runner checkout's .env. If the mini is asleep at 04:30, launchd runs it once on wake.
     Installed by Alex only after he approves a direct run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.esep.notion-export</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sameoldexpressions/Developer/Empire_State_Events_Pipeline_Take_3/ops/mini-runner/run-job.sh</string>
    <string>export</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-notion-export.log</string>
  <key>StandardErrorPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-notion-export.log</string>
</dict>
</plist>
