<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- YED-347 / YED-384: nightly read-only reconcile --report at 05:00 local (America/New_York).
     launchd uses local time, so this stays 05:00 ET across DST (10:00 UTC in winter, 09:00 UTC in summer).
     If the mini is asleep or off at 05:00, launchd runs it once on wake. Installed by Alex only after he approves the report. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.esep.nightly-reconcile</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sameoldexpressions/Developer/Empire_State_Events_Pipeline_Take_3/ops/mini-runner/run-job.sh</string>
    <string>reconcile</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-nightly-reconcile.log</string>
  <key>StandardErrorPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-nightly-reconcile.log</string>
</dict>
</plist>
