<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- YED-395: hourly read-only pull of the laptop's local inventories into ~/Developer/esep-inputs (outside git).
     A failed hour (laptop asleep or off Tailscale) just retries the next hour. Installed by Alex. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.esep.sync-inputs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sameoldexpressions/Developer/Empire_State_Events_Pipeline_Take_3/ops/mini-runner/run-job.sh</string>
    <string>sync</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-sync-inputs.log</string>
  <key>StandardErrorPath</key><string>/Users/sameoldexpressions/Library/Logs/esep-runner/launchd-sync-inputs.log</string>
</dict>
</plist>
